{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@nx-ng-v22/layout": [
        "./libs/layout/src/index.ts"
      ],
      "@nx-ng-v22/core": [
        "./libs/core/src/index.ts"
      ],
      "@nx-ng-v22/ui": [
        "./libs/ui/src/index.ts"
      ],
      "@nx-ng-v22/shared": [
        "./libs/shared/src/index.ts"
      ],
      "@nx-ng-v22/builderkit": [
        "./libs/builderkit/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
